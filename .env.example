# Database Configuration
DATABASE_URL=postgresql://creditbench:creditbench@localhost:5432/creditbench

# API Keys
ANTHROPIC_API_KEY=your-key-here

# Embedding Model (optional, defaults to text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# LLM Model (optional, defaults to claude-3-5-sonnet)
LLM_MODEL=claude-3-5-sonnet-20241022

# Data Source (OneDrive mount path or local path)
DATA_DIR=./data

# Azure Blob Storage for fundamentals parquet files (optional)
# If set, DuckDB will query parquet directly from Azure instead of local files
# Leave blank to use local OneDrive mount
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_SAS_TOKEN=
AZURE_BLOB_CONTAINER=creditbench
AZURE_FUNDAMENTALS_PATH=foundamentals

# OpenAI API Key (for transcript embeddings via Batch API)
OPENAI_API_KEY=your-openai-key-here

# Google API Key (legacy — Gemini embedding, optional)
GOOGLE_API_KEY=

# Application Settings
LOG_LEVEL=INFO
